# Example only. Create credentials outside the checkout with setup-community107.cjs.
NODE_ENV=production
HOST=127.0.0.1
PORT=8766
CAMPUS_PUBLIC_ORIGIN=https://campus.example
CAMPUS_TRUST_PROXY=127.0.0.1
CAMPUS_DATA_DIR=/var/lib/3nu/community

# Optional operations readiness gate; enable with the scheduled backup package.
# /ready stays 503 until the first successful backup, on failure or after 30 hours.
CAMPUS_BACKUP_STATUS_FILE=/var/lib/3nu/ops/backup-status.json
CAMPUS_BACKUP_MAX_AGE_HOURS=30
