# Install outside checkout, root:3nu 0640. No real credentials in this template.
CAMPUS_DATA_DIR=/var/lib/3nu/community
CAMPUS_BACKUP_ROOT=/var/lib/3nu/backups
CAMPUS_BACKUP_STATUS_FILE=/var/lib/3nu/ops/backup-status.json
# Default fails the job until independent encrypted storage has been configured.
CAMPUS_BACKUP_REQUIRE_OFFSITE=true
RESTIC_BIN=/usr/bin/restic
RESTIC_CACHE_DIR=/var/cache/3nu-restic
RESTIC_PASSWORD_FILE=/etc/3nu/restic-password
# Fill after choosing/authorizing storage; do not put it in Git.
RESTIC_REPOSITORY=
# Provider credentials (if needed) belong only in the installed private file.
